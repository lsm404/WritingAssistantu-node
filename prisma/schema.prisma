generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  displayName  String       @map("display_name")
  role         String       @default("user")
  status       String       @default("active")
  signupIp     String?      @map("signup_ip")
  signupSubnet String?      @map("signup_subnet")
  agentId      String?      @map("agent_id")
  signupInviteCode String?  @map("signup_invite_code")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  orders       Order[]
  sessions     Session[]
  modelConfig  ModelConfig?
  registrationDeviceLink RegistrationDeviceLink?
  invitedBy   Agent?       @relation("AgentToUser", fields: [agentId], references: [id], onDelete: SetNull)
  ownedAgent  Agent?       @relation("AgentOwner")
  prompts      Prompt[]
  wechatAccounts           WechatAccount[]
  articleGenerationLogs    ArticleGenerationLog[]
  activeWechatClientKey    String?       @map("active_wechat_client_key")
  quota                    UserQuota?

  @@index([signupIp, createdAt])
  @@index([signupSubnet, createdAt])
  @@index([agentId])
  @@index([signupInviteCode])
  @@map("users")
}

/// 注册时上报的设备 ID 与账号关联，用于「单设备注册账号数」限制
model RegistrationDeviceLink {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  deviceId  String   @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("registration_device_links")
}

model Agent {
  id          String   @id @default(uuid())
  userId      String?  @unique @map("user_id")
  name        String
  inviteCode  String   @unique @map("invite_code")
  contactWechat String? @map("contact_wechat")
  canGrantMembership Boolean @default(false) @map("can_grant_membership")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]   @relation("AgentToUser")
  owner       User?    @relation("AgentOwner", fields: [userId], references: [id])

  @@map("agents")
}

model Admin {
  id           String         @id @default(uuid())
  phone        String         @unique
  passwordHash String         @map("password_hash")
  displayName  String         @map("display_name")
  role         String         @default("super_admin")
  status       String         @default("active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admins")
}

model Plan {
  id           String       @id
  code         String       @unique
  name         String
  billingType  String       @map("billing_type")
  priceCents   Int          @map("price_cents")
  durationDays Int?         @map("duration_days")
  isLifetime   Boolean      @default(false) @map("is_lifetime")
  isActive     Boolean      @default(true) @map("is_active")
  sortOrder    Int          @default(0) @map("sort_order")
  planCategory String       @default("text_image") @map("plan_category")
  textDailyLimit Int        @default(0) @map("text_daily_limit")
  textMonthlyLimit Int?     @map("text_monthly_limit")
  imageMonthlyLimit Int     @default(0) @map("image_monthly_limit")
  deAiMonthlyLimit Int      @default(0) @map("de_ai_monthly_limit")
  wechatAccountLimit Int    @default(0) @map("wechat_account_limit")
  featuresJson  String?     @map("features_json")
  tagline       String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  orders       Order[]

  @@map("plans")
}

model Membership {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  planId    String    @map("plan_id")
  status    String
  startAt   DateTime  @map("start_at")
  endAt     DateTime? @map("end_at")
  source    String    @default("manual")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("memberships")
}

model Order {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  planId      String    @map("plan_id")
  orderNo     String    @unique @map("order_no")
  amountCents Int       @map("amount_cents")
  status      String
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("orders")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@map("admin_sessions")
}

model ModelConfig {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  textApiKey       String?  @map("text_api_key")
  textModel        String?  @map("text_model")
  imageApiKey      String?  @map("image_api_key")
  imageModel       String?  @map("image_model")
  enableWebSearch  Boolean  @default(false) @map("enable_web_search")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("model_configs")
}

model Prompt {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prompts")
}

/// 桌面端公众号账号配置（与客户端 account.id 对齐的 client_key）
model WechatAccount {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  clientKey    String   @map("client_key")
  name         String
  appId        String   @map("app_id")
  appSecret    String   @map("app_secret")
  thumbMediaId String   @default("") @map("thumb_media_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientKey])
  @@index([userId])
  @@map("wechat_accounts")
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model UserQuota {
  userId     String   @id @map("user_id")
  textUsed   Int      @default(0) @map("text_used")
  textDate   String   @default("") @map("text_date")
  imageUsed  Int      @default(0) @map("image_used")
  imageMonth String   @default("") @map("image_month")
  deAiUsed   Int      @default(0) @map("de_ai_used")
  deAiPeriod String   @default("") @map("de_ai_period")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

model ArticleGenerationLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  kind         String   @default("text")
  clientSource String   @default("unknown") @map("client_source")
  topic        String?
  creationMode String?  @map("creation_mode")
  model        String?
  articleChars Int      @default(0) @map("article_chars")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind])
  @@map("article_generation_logs")
}
